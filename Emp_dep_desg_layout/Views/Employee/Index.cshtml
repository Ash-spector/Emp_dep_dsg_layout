@model IEnumerable<Emp_dep_desg_layout.Models.Employee>
    @{ 
        Layout = "~/Views/Shared/_Layout-slate.cshtml";
    }

<h2 class=" text-bg-white text-center text-primary">Employee List</h2>

@Html.ActionLink("New Employee", "Upsert", "Employee", new { @class = "btn btn-info" })
@if (!Model.Any())
{
    <p class=" text-danger">Data Not Found</p>

}
else
{


    <table class="table table-bordered table-striped" style="padding:15px;">

        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Salary</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                using (Html.BeginForm("Delete", "Employee", new { id = employee.Id }))
                {
                    <tr>
                        <td>@employee.Name</td>
                        <td>@employee.Address</td>
                        <td>@employee.Salary</td>
                        <td>@employee.Department.name</td>
                        <td>@employee.Designation.Name</td>
                        <td>
                            @Html.ActionLink("Edit", "Upsert", new { id = employee.Id }, new { @class = "btn btn-success" })
                            @Html.ActionLink("Details", "Details", new { id = employee.Id }, new { @class = "btn btn-info" })
                            @*@Html.ActionLink("Delete", "Delete", new { id = employee.Id }, new { @class = "btn btn-danger" })*@
                            <input type="submit" class=" btn btn-danger" value=" Delete" onclick="return confirm('Want to Delete Data ?')"/>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
}


